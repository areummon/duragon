{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Duragon",
  "version": "0.2.0",
  "identifier": "dev.duragon.app",
  "build": {
    "beforeDevCommand": "npm run voice && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run voice && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Duragon",
        "create": false,
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "data:",
        "connect-src": "ipc: http://ipc.localhost",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "A quiet local-first notebook where an AI mind reads along",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
